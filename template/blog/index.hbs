{{#> base}}
	{{#*inline "head"}}
		<title>Blog</title>
		<meta property="og:title" content="Blog">

		<link type="application/atom+xml" rel="alternate" href="{{feed}}" title="Blog">
	{{/inline}}
	{{#*inline "body"}}
		<h1>
			Recent posts
			<a href="{{feed}}" title="Atom Feed">
				<img width="auto;" height="16" alt="RSS icon" src="/static/feed-icon.svg">
			</a>
		</h1>
		{{#each posts}}
			<li>
				{{#if content}}
					<a href="{{stem}}">{{content.markdown.title}}</a>
					{{#if content.metadata.published}}
						(<time datetime="{{content.metadata.published}}">{{content.metadata.published}}</time>)
					{{else}}
						(draft)
					{{/if}}
				{{else}}
					<a href="{{stem}}">Error generating post from {{stem}}.md</a>
				{{/if}}
			</li>
		{{/each}}
		<h2>Some of my favourite blogs</h2>
		<ul>
			<li><a href="https://confusecompiler.org/articles">Leana's Blog</a></li>
			<li><a href="https://blog.haskell.org/">Haskell Fondation's Blog</a></li>
		<ul>
	{{/inline}}
{{/base}}
